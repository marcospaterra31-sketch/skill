# ==============================================================================
# SKILL FORGE — AMBIENTE & CONFIGURAÇÕES (FASE 0)
# ==============================================================================

# Database / PostgreSQL & Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skillforge?schema=public"

# AI Providers (Provedores de IA Suportados)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."

# Default AI Model Provider (gemini | openai | claude)
DEFAULT_AI_PROVIDER="gemini"

# Security & Session
AUTH_SECRET="your-32-character-secret-key-change-in-production"
SESSION_EXPIRY="7d"

# App & Server Configuration
APP_URL="MY_APP_URL"
PORT="3000"
NODE_ENV="development"
